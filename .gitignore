# 构建产物
/build/
/entry/build/
/.hvigor/
/oh_modules/
/entry/oh_modules/
build.log

# IDE
/.idea/
*.iml

# 签名材料只放在本机的 signing/ 文件夹,绝不能进版本库:证书、profile、密钥库、
# material(解密密码用的密钥)、local.json5(加密后的密码)、devices.json(真机 UDID)。
# 只有说明样例 local.example.json5 例外。
# build-profile.json5 进版本库,但里面不写签名(见它顶部的注释)。
/signing/*
!/signing/local.example.json5
*.p12
*.p7b
*.cer
*.csr

# devtest 从生产源码同步出来的副本(每次跑 sync-and-test.mjs 都会重新生成)
/devtest/srs.ts
/devtest/ebbinghaus.ts
/devtest/Models.ts
/devtest/Quizify.ts
/devtest/Schema.ts
/devtest/Inline.ts
/devtest/Yaml.ts
/devtest/YamlExport.ts
/devtest/SyncCore.ts
/devtest/Timing.ts

# 发布工具的本地镜像(已发布牌组 + catalog.json),是云存储 public/ 的副本
/tools/publish/mirror/
/devtest/Steps.ts

# 系统垃圾
.DS_Store
Thumbs.db

# Kiro 的会话导出文件。不是源码,而且会长到几十 MB。
REPS.json
*.kiro-session.json

# AGC 配置:含 client_secret / api_key,不进版本库。每台开发机从 AGC 控制台下载放到这里
/entry/src/main/resources/rawfile/agconnect-services.json
